<!DOCTYPE html>
{#- The wordmark: the two words of the site name with an accent middle dot
    between them. The dot is decoration, so screen readers ignore it. -#}
{%- macro wordmark() -%}
{%- set words = site.name.split(" ") -%}
<span class="wordmark">{{ words[0] }} <span class="wordmark-dot" aria-hidden="true">&middot;</span> {{ words[1] }}</span>
{%- endmacro %}
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  {#- Apply a saved theme before the first paint. Without a saved theme, the
      page obeys the operating system setting. -#}
  <script>
    try{var t=localStorage.getItem("theme");if(t==="light"||t==="dark")document.documentElement.setAttribute("data-theme",t)}catch(e){}
  </script>
  <title>{{ title }} — {{ site.name }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ title }} — {{ site.name }}">
  <meta property="og:description" content="{{ description or site.description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/og-image.png">
  <meta property="og:image:width" content="1024">
  <meta property="og:image:height" content="1024">
  <meta property="og:image:alt" content="Integritas Civica logo">
  <meta name="twitter:card" content="summary">
  <link rel="icon" type="image/svg+xml" href="/assets/ic-logo.svg">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
  <link rel="preload" href="/css/fonts/lora-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/css/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/tokens.css">
  <link rel="stylesheet" href="/css/style.css">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "{{ site.url }}/#organization",
        "name": "{{ site.name }}",
        "url": "{{ site.url }}",
        "description": "{{ site.description }}",
        "sameAs": {{ site.social | nonEmptyValues | dump | safe }}
      },
      {
        "@type": "WebSite",
        "@id": "{{ site.url }}/#website",
        "url": "{{ site.url }}",
        "name": "{{ site.name }}",
        "publisher": {
          "@id": "{{ site.url }}/#organization"
        }
      },
      {
        "@type": "WebPage",
        "@id": "{{ site.url }}{{ page.url }}",
        "url": "{{ site.url }}{{ page.url }}",
        "name": "{{ title }}",
        "description": "{{ description or site.description }}",
        "isPartOf": {
          "@id": "{{ site.url }}/#website"
        }
      }
    ]
  }
  </script>
  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-JjbZVllR3vOXRaISKbUdY.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <header>
    <div class="header-inner">
      <a href="/" class="site-title">
        <img src="/assets/ic-logo.svg" alt="" class="site-logo" width="32" height="32">
        {{ wordmark() }}
      </a>
      <nav aria-label="Main navigation">
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.text }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
      {#- The script at the end of the page shows this button. Without
          JavaScript, the button stays hidden. -#}
      <button type="button" class="theme-toggle" aria-pressed="false" hidden>Dark theme</button>
    </div>
  </header>

  <main id="main">
    <article>
      {{ content | safe }}
    </article>
  </main>

  <footer>
    <div class="footer-inner">
      <p>&copy; 2026 {{ wordmark() }}. All rights reserved.</p>
      <p><a href="/privacy/">Privacy Policy</a></p>
    </div>
  </footer>
  <script>
    /* The theme toggle. A choice that is different from the operating system
       setting is saved as data-theme. A choice that agrees with the setting
       removes data-theme, and the page obeys the operating system again. */
    (function () {
      var button = document.querySelector(".theme-toggle");
      if (!button || !window.matchMedia) return;
      var root = document.documentElement;
      var system = window.matchMedia("(prefers-color-scheme: dark)");
      function isDark() {
        var theme = root.getAttribute("data-theme");
        return theme ? theme === "dark" : system.matches;
      }
      function sync() {
        button.setAttribute("aria-pressed", isDark() ? "true" : "false");
      }
      button.addEventListener("click", function () {
        var next = isDark() ? "light" : "dark";
        var same = (next === "dark") === system.matches;
        try {
          if (same) {
            root.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          } else {
            root.setAttribute("data-theme", next);
            localStorage.setItem("theme", next);
          }
        } catch (e) {}
        sync();
      });
      if (system.addEventListener) system.addEventListener("change", sync);
      button.hidden = false;
      sync();
    })();
  </script>
</body>
</html>
